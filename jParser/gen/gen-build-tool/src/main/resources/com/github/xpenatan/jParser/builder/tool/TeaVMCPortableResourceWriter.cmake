if(NOT DEFINED @VARIABLE_PREFIX@_ROOT OR "${@VARIABLE_PREFIX@_ROOT}" STREQUAL "")
  get_filename_component(@VARIABLE_PREFIX@_EXTERNAL_CPP_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
  set(@VARIABLE_PREFIX@_ROOT "${@VARIABLE_PREFIX@_EXTERNAL_CPP_ROOT}/jparser/@RESOURCE_NAME@")
endif()
set(@VARIABLE_PREFIX@_GLUE_ROOT "${@VARIABLE_PREFIX@_ROOT}/glue")
set(@VARIABLE_PREFIX@_CUSTOM_ROOT "${@VARIABLE_PREFIX@_ROOT}/custom")
set(@VARIABLE_PREFIX@_RUNTIME_ROOT "${@VARIABLE_PREFIX@_ROOT}/runtime")
set(@VARIABLE_PREFIX@_SOURCE_ROOT "${@VARIABLE_PREFIX@_ROOT}/source")
set(@VARIABLE_PREFIX@_IMPORT_HEADER "${@VARIABLE_PREFIX@_ROOT}/imports/teavmc_imports.h")
set(@VARIABLE_PREFIX@_NATIVE_ROOT "${@VARIABLE_PREFIX@_ROOT}/native")

# Portable consumers may set JPARSER_TEAVMC_APP_TARGET before including this file.
# Preserve the established gdx-teavm target variable as a compatibility fallback.
if(NOT DEFINED JPARSER_TEAVMC_APP_TARGET OR "${JPARSER_TEAVMC_APP_TARGET}" STREQUAL "")
  if(DEFINED TEAVM_APP_TARGET AND NOT "${TEAVM_APP_TARGET}" STREQUAL "")
    set(JPARSER_TEAVMC_APP_TARGET "${TEAVM_APP_TARGET}")
  else()
    message(FATAL_ERROR "Set JPARSER_TEAVMC_APP_TARGET to the TeaVM C application target before including this file.")
  endif()
endif()

# Portable consumers may override the directory containing TeaVM's generated C sources.
# The default matches the extraction layout used by gdx-teavm.
if(NOT DEFINED JPARSER_TEAVMC_GENERATED_SOURCE_ROOT OR "${JPARSER_TEAVMC_GENERATED_SOURCE_ROOT}" STREQUAL "")
  set(JPARSER_TEAVMC_GENERATED_SOURCE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/c/src")
endif()

if(NOT DEFINED @VARIABLE_PREFIX@_LIBRARY OR "${@VARIABLE_PREFIX@_LIBRARY}" STREQUAL "")
  set(@VARIABLE_PREFIX@_LIBRARY_CANDIDATES)
  if(WIN32)
    list(APPEND @VARIABLE_PREFIX@_LIBRARY_CANDIDATES
      "${@VARIABLE_PREFIX@_NATIVE_ROOT}/windows_x64/@LIBRARY_NAME@64_.lib")
  elseif(APPLE)
    if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64|ARM64")
      list(APPEND @VARIABLE_PREFIX@_LIBRARY_CANDIDATES
        "${@VARIABLE_PREFIX@_NATIVE_ROOT}/mac_arm64/lib@LIBRARY_NAME@64_.a")
    else()
      list(APPEND @VARIABLE_PREFIX@_LIBRARY_CANDIDATES
        "${@VARIABLE_PREFIX@_NATIVE_ROOT}/mac_x64/lib@LIBRARY_NAME@64_.a")
    endif()
  elseif(UNIX)
    list(APPEND @VARIABLE_PREFIX@_LIBRARY_CANDIDATES
      "${@VARIABLE_PREFIX@_NATIVE_ROOT}/linux_x64/lib@LIBRARY_NAME@64_.a")
  endif()

  foreach(@VARIABLE_PREFIX@_LIBRARY_CANDIDATE IN LISTS @VARIABLE_PREFIX@_LIBRARY_CANDIDATES)
    if(EXISTS "${@VARIABLE_PREFIX@_LIBRARY_CANDIDATE}")
      set(@VARIABLE_PREFIX@_LIBRARY "${@VARIABLE_PREFIX@_LIBRARY_CANDIDATE}")
      break()
    endif()
  endforeach()
endif()

if(NOT @VARIABLE_PREFIX@_LIBRARY OR NOT EXISTS "${@VARIABLE_PREFIX@_LIBRARY}")
  message(FATAL_ERROR "Missing @LIBRARY_NAME@ TeaVM C static library. Add the matching native artifact under ${@VARIABLE_PREFIX@_NATIVE_ROOT}, or set @VARIABLE_PREFIX@_LIBRARY explicitly before including this file.")
endif()

set(@VARIABLE_PREFIX@_GLUE_SOURCE "${@VARIABLE_PREFIX@_GLUE_ROOT}/TeaVMCGlue.cpp")
if(NOT EXISTS "${@VARIABLE_PREFIX@_GLUE_SOURCE}")
  message(FATAL_ERROR "Missing @LIBRARY_NAME@ TeaVM C glue source: ${@VARIABLE_PREFIX@_GLUE_SOURCE}")
endif()
if(NOT EXISTS "${@VARIABLE_PREFIX@_IMPORT_HEADER}")
  message(FATAL_ERROR "Missing @LIBRARY_NAME@ TeaVM C import header: ${@VARIABLE_PREFIX@_IMPORT_HEADER}")
endif()

enable_language(CXX)
target_sources(${JPARSER_TEAVMC_APP_TARGET} PRIVATE "${@VARIABLE_PREFIX@_GLUE_SOURCE}")
set_source_files_properties("${@VARIABLE_PREFIX@_GLUE_SOURCE}" PROPERTIES LANGUAGE CXX)
target_compile_features(${JPARSER_TEAVMC_APP_TARGET} PRIVATE cxx_std_17)
if(MSVC)
  # Packaged Windows archives use the release dynamic CRT in every app configuration.
  target_compile_options(${JPARSER_TEAVMC_APP_TARGET} PRIVATE "/MD")
  target_compile_definitions(${JPARSER_TEAVMC_APP_TARGET} PRIVATE "_ITERATOR_DEBUG_LEVEL=0")
endif()

target_include_directories(${JPARSER_TEAVMC_APP_TARGET} PRIVATE
  "${@VARIABLE_PREFIX@_GLUE_ROOT}"
  "${@VARIABLE_PREFIX@_CUSTOM_ROOT}"
  "${@VARIABLE_PREFIX@_RUNTIME_ROOT}"
  "${@VARIABLE_PREFIX@_SOURCE_ROOT}"
  "${@VARIABLE_PREFIX@_SOURCE_ROOT}/include"
  "${@VARIABLE_PREFIX@_SOURCE_ROOT}/src")

file(GLOB_RECURSE @VARIABLE_PREFIX@_GENERATED_C_SOURCES CONFIGURE_DEPENDS
  "${JPARSER_TEAVMC_GENERATED_SOURCE_ROOT}/*.c")

if(MSVC)
  foreach(@VARIABLE_PREFIX@_SOURCE IN LISTS @VARIABLE_PREFIX@_GENERATED_C_SOURCES)
    set_property(SOURCE "${@VARIABLE_PREFIX@_SOURCE}" APPEND PROPERTY COMPILE_OPTIONS "/FI${@VARIABLE_PREFIX@_IMPORT_HEADER}")
  endforeach()
else()
  foreach(@VARIABLE_PREFIX@_SOURCE IN LISTS @VARIABLE_PREFIX@_GENERATED_C_SOURCES)
    set_property(SOURCE "${@VARIABLE_PREFIX@_SOURCE}" APPEND PROPERTY COMPILE_OPTIONS "-include" "${@VARIABLE_PREFIX@_IMPORT_HEADER}")
  endforeach()
endif()

target_link_libraries(${JPARSER_TEAVMC_APP_TARGET} PRIVATE "${@VARIABLE_PREFIX@_LIBRARY}")
