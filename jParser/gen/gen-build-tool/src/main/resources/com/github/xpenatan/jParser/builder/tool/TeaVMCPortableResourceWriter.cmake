if(NOT DEFINED @VARIABLE_PREFIX@_ROOT OR "${@VARIABLE_PREFIX@_ROOT}" STREQUAL "")
  get_filename_component(@VARIABLE_PREFIX@_EXTERNAL_CPP_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
  set(@VARIABLE_PREFIX@_ROOT "${@VARIABLE_PREFIX@_EXTERNAL_CPP_ROOT}/jparser/@RESOURCE_NAME@")
endif()
if(NOT DEFINED @VARIABLE_PREFIX@_EXTERNAL_CPP_ROOT OR "${@VARIABLE_PREFIX@_EXTERNAL_CPP_ROOT}" STREQUAL "")
  get_filename_component(@VARIABLE_PREFIX@_EXTERNAL_CPP_ROOT "${@VARIABLE_PREFIX@_ROOT}/../.." ABSOLUTE)
endif()

set(@VARIABLE_PREFIX@_GLUE_ROOT "${@VARIABLE_PREFIX@_ROOT}/glue")
set(@VARIABLE_PREFIX@_CUSTOM_ROOT "${@VARIABLE_PREFIX@_ROOT}/custom")
set(@VARIABLE_PREFIX@_RUNTIME_ROOT "${@VARIABLE_PREFIX@_ROOT}/runtime")
set(@VARIABLE_PREFIX@_SOURCE_ROOT "${@VARIABLE_PREFIX@_ROOT}/source")
set(@VARIABLE_PREFIX@_ABI_ROOT "${@VARIABLE_PREFIX@_ROOT}/teavmcabi")
set(@VARIABLE_PREFIX@_IMPORT_HEADER "${@VARIABLE_PREFIX@_ROOT}/imports/teavmc_imports.h")
set(@VARIABLE_PREFIX@_DISPATCH_HEADER "${@VARIABLE_PREFIX@_ABI_ROOT}/TeaVMCDispatch.h")
set(@VARIABLE_PREFIX@_DISPATCH_SOURCE "${@VARIABLE_PREFIX@_ABI_ROOT}/TeaVMCDispatch.cpp")
set(@VARIABLE_PREFIX@_LOADER_ROOT "${@VARIABLE_PREFIX@_EXTERNAL_CPP_ROOT}/jparser/loader")
set(@VARIABLE_PREFIX@_NATIVE_ROOT "${@VARIABLE_PREFIX@_ROOT}/native")

# Portable consumers may set JPARSER_TEAVMC_APP_TARGET before including this file.
# Preserve the established gdx-teavm target variable as a compatibility fallback.
if(NOT DEFINED JPARSER_TEAVMC_APP_TARGET OR "${JPARSER_TEAVMC_APP_TARGET}" STREQUAL "")
  if(DEFINED TEAVM_APP_TARGET AND NOT "${TEAVM_APP_TARGET}" STREQUAL "")
    set(JPARSER_TEAVMC_APP_TARGET "${TEAVM_APP_TARGET}")
  else()
    message(FATAL_ERROR "Set JPARSER_TEAVMC_APP_TARGET to the TeaVM C application target before including this file.")
  endif()
endif()

# A per-library linkage selection wins over the global selection. The generated
# default remains STATIC unless the producer explicitly selected another mode.
if(NOT DEFINED @VARIABLE_PREFIX@_LINKAGE OR "${@VARIABLE_PREFIX@_LINKAGE}" STREQUAL "")
  if(DEFINED JPARSER_TEAVMC_LINKAGE AND NOT "${JPARSER_TEAVMC_LINKAGE}" STREQUAL "")
    set(@VARIABLE_PREFIX@_LINKAGE "${JPARSER_TEAVMC_LINKAGE}")
  else()
    set(@VARIABLE_PREFIX@_LINKAGE "@DEFAULT_LINKAGE@")
  endif()
endif()
string(TOUPPER "${@VARIABLE_PREFIX@_LINKAGE}" @VARIABLE_PREFIX@_LINKAGE)
if(NOT @VARIABLE_PREFIX@_LINKAGE STREQUAL "STATIC"
    AND NOT @VARIABLE_PREFIX@_LINKAGE STREQUAL "SHARED_LINKED"
    AND NOT @VARIABLE_PREFIX@_LINKAGE STREQUAL "RUNTIME_LOADED")
  message(FATAL_ERROR "Invalid @LIBRARY_NAME@ TeaVM C linkage '${@VARIABLE_PREFIX@_LINKAGE}'. Expected STATIC, SHARED_LINKED, or RUNTIME_LOADED.")
endif()

# Portable consumers may override the directory containing TeaVM's generated C sources.
if(NOT DEFINED JPARSER_TEAVMC_GENERATED_SOURCE_ROOT OR "${JPARSER_TEAVMC_GENERATED_SOURCE_ROOT}" STREQUAL "")
  set(JPARSER_TEAVMC_GENERATED_SOURCE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/c/src")
endif()

if(NOT EXISTS "${@VARIABLE_PREFIX@_DISPATCH_SOURCE}")
  message(FATAL_ERROR "Missing @LIBRARY_NAME@ TeaVM C descriptor/dispatch source: ${@VARIABLE_PREFIX@_DISPATCH_SOURCE}")
endif()
if(NOT EXISTS "${@VARIABLE_PREFIX@_LOADER_ROOT}/teavmc_loader.h")
  message(FATAL_ERROR "Missing jParser TeaVM C loader header. Add loader-c resources beside the generated binding resources.")
endif()

enable_language(CXX)
target_sources(${JPARSER_TEAVMC_APP_TARGET} PRIVATE "${@VARIABLE_PREFIX@_DISPATCH_SOURCE}")
set_source_files_properties("${@VARIABLE_PREFIX@_DISPATCH_SOURCE}" PROPERTIES LANGUAGE CXX)
target_compile_features(${JPARSER_TEAVMC_APP_TARGET} PRIVATE cxx_std_17)

if(@VARIABLE_PREFIX@_LINKAGE STREQUAL "STATIC")
  set(@VARIABLE_PREFIX@_LINKAGE_VALUE 0)
elseif(@VARIABLE_PREFIX@_LINKAGE STREQUAL "SHARED_LINKED")
  set(@VARIABLE_PREFIX@_LINKAGE_VALUE 1)
else()
  set(@VARIABLE_PREFIX@_LINKAGE_VALUE 2)
endif()
set_property(SOURCE "${@VARIABLE_PREFIX@_DISPATCH_SOURCE}" APPEND PROPERTY
  COMPILE_DEFINITIONS "JPARSER_TEAVMC_LINKAGE_MODE=${@VARIABLE_PREFIX@_LINKAGE_VALUE}")

# jParser never chooses the MSVC runtime. Inspect the consumer's existing
# standard CMake selection only so the matching packaged payload can be used.
set(@VARIABLE_PREFIX@_MSVC_RUNTIME_SUBDIR "")
if(MSVC)
  get_target_property(@VARIABLE_PREFIX@_MSVC_RUNTIME_VALUE
    ${JPARSER_TEAVMC_APP_TARGET} MSVC_RUNTIME_LIBRARY)
  if(NOT @VARIABLE_PREFIX@_MSVC_RUNTIME_VALUE
      OR @VARIABLE_PREFIX@_MSVC_RUNTIME_VALUE MATCHES "-NOTFOUND$")
    if(DEFINED CMAKE_MSVC_RUNTIME_LIBRARY
        AND NOT "${CMAKE_MSVC_RUNTIME_LIBRARY}" STREQUAL "")
      set(@VARIABLE_PREFIX@_MSVC_RUNTIME_VALUE "${CMAKE_MSVC_RUNTIME_LIBRARY}")
    else()
      # This is CMake's documented default when CMP0091 is NEW. The OLD
      # policy also defaults to the MD family through the compiler flags.
      # Use it only to select a matching payload; do not change the target.
      set(@VARIABLE_PREFIX@_MSVC_RUNTIME_VALUE
        "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    endif()
  endif()
  string(TOUPPER "${@VARIABLE_PREFIX@_MSVC_RUNTIME_VALUE}" @VARIABLE_PREFIX@_MSVC_RUNTIME_VALUE)
  if(@VARIABLE_PREFIX@_MSVC_RUNTIME_VALUE MATCHES "DLL" OR @VARIABLE_PREFIX@_MSVC_RUNTIME_VALUE STREQUAL "/MD")
    set(@VARIABLE_PREFIX@_MSVC_RUNTIME_SUBDIR "md")
  elseif(@VARIABLE_PREFIX@_MSVC_RUNTIME_VALUE MATCHES "MULTITHREADED"
      OR @VARIABLE_PREFIX@_MSVC_RUNTIME_VALUE STREQUAL "/MT")
    set(@VARIABLE_PREFIX@_MSVC_RUNTIME_SUBDIR "mt")
  endif()
endif()

target_include_directories(${JPARSER_TEAVMC_APP_TARGET} PRIVATE
  "${@VARIABLE_PREFIX@_GLUE_ROOT}"
  "${@VARIABLE_PREFIX@_ABI_ROOT}"
  "${@VARIABLE_PREFIX@_LOADER_ROOT}"
  "${@VARIABLE_PREFIX@_CUSTOM_ROOT}"
  "${@VARIABLE_PREFIX@_RUNTIME_ROOT}"
  "${@VARIABLE_PREFIX@_SOURCE_ROOT}"
  "${@VARIABLE_PREFIX@_SOURCE_ROOT}/include"
  "${@VARIABLE_PREFIX@_SOURCE_ROOT}/src")

# Resolve platform payload names. iOS intentionally relies on explicit overrides
# until its final archive/framework packaging contract is introduced.
set(@VARIABLE_PREFIX@_PLATFORM "")
set(@VARIABLE_PREFIX@_STATIC_FILE "")
set(@VARIABLE_PREFIX@_SHARED_FILE "")
set(@VARIABLE_PREFIX@_IMPORT_FILE "")
if(WIN32)
  set(@VARIABLE_PREFIX@_PLATFORM "windows_x64")
  set(@VARIABLE_PREFIX@_STATIC_FILE "@LIBRARY_NAME@64_.lib")
  set(@VARIABLE_PREFIX@_SHARED_FILE "@LIBRARY_NAME@64.dll")
  set(@VARIABLE_PREFIX@_IMPORT_FILE "@LIBRARY_NAME@64.lib")
elseif(ANDROID)
  set(@VARIABLE_PREFIX@_PLATFORM "android/${ANDROID_ABI}")
  set(@VARIABLE_PREFIX@_STATIC_FILE "lib@LIBRARY_NAME@.a")
  set(@VARIABLE_PREFIX@_SHARED_FILE "lib@LIBRARY_NAME@.so")
elseif(APPLE AND NOT CMAKE_SYSTEM_NAME STREQUAL "iOS")
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64|ARM64")
    set(@VARIABLE_PREFIX@_PLATFORM "mac_arm64")
    set(@VARIABLE_PREFIX@_STATIC_FILE "lib@LIBRARY_NAME@64_.a")
    set(@VARIABLE_PREFIX@_SHARED_FILE "lib@LIBRARY_NAME@arm64.dylib")
  else()
    set(@VARIABLE_PREFIX@_PLATFORM "mac_x64")
    set(@VARIABLE_PREFIX@_STATIC_FILE "lib@LIBRARY_NAME@64_.a")
    set(@VARIABLE_PREFIX@_SHARED_FILE "lib@LIBRARY_NAME@64.dylib")
  endif()
elseif(UNIX)
  set(@VARIABLE_PREFIX@_PLATFORM "linux_x64")
  set(@VARIABLE_PREFIX@_STATIC_FILE "lib@LIBRARY_NAME@64_.a")
  set(@VARIABLE_PREFIX@_SHARED_FILE "lib@LIBRARY_NAME@64.so")
endif()

if(@VARIABLE_PREFIX@_LINKAGE STREQUAL "STATIC")
  if(NOT DEFINED @VARIABLE_PREFIX@_LIBRARY OR "${@VARIABLE_PREFIX@_LIBRARY}" STREQUAL "")
    set(@VARIABLE_PREFIX@_LIBRARY_CANDIDATES)
    if(NOT "${@VARIABLE_PREFIX@_PLATFORM}" STREQUAL "")
      if(WIN32 AND NOT "${@VARIABLE_PREFIX@_MSVC_RUNTIME_SUBDIR}" STREQUAL "")
        list(APPEND @VARIABLE_PREFIX@_LIBRARY_CANDIDATES
          "${@VARIABLE_PREFIX@_NATIVE_ROOT}/${@VARIABLE_PREFIX@_PLATFORM}/${@VARIABLE_PREFIX@_MSVC_RUNTIME_SUBDIR}/static/${@VARIABLE_PREFIX@_STATIC_FILE}"
          "${@VARIABLE_PREFIX@_NATIVE_ROOT}/${@VARIABLE_PREFIX@_PLATFORM}/${@VARIABLE_PREFIX@_MSVC_RUNTIME_SUBDIR}/${@VARIABLE_PREFIX@_STATIC_FILE}")
      endif()
      list(APPEND @VARIABLE_PREFIX@_LIBRARY_CANDIDATES
        "${@VARIABLE_PREFIX@_NATIVE_ROOT}/${@VARIABLE_PREFIX@_PLATFORM}/${@VARIABLE_PREFIX@_STATIC_FILE}"
        "${@VARIABLE_PREFIX@_NATIVE_ROOT}/${@VARIABLE_PREFIX@_PLATFORM}/static/${@VARIABLE_PREFIX@_STATIC_FILE}")
    endif()
    foreach(@VARIABLE_PREFIX@_CANDIDATE IN LISTS @VARIABLE_PREFIX@_LIBRARY_CANDIDATES)
      if(EXISTS "${@VARIABLE_PREFIX@_CANDIDATE}")
        set(@VARIABLE_PREFIX@_LIBRARY "${@VARIABLE_PREFIX@_CANDIDATE}")
        break()
      endif()
    endforeach()
  endif()
  if(NOT @VARIABLE_PREFIX@_LIBRARY OR NOT EXISTS "${@VARIABLE_PREFIX@_LIBRARY}")
    message(FATAL_ERROR "Missing @LIBRARY_NAME@ TeaVM C static library. Add the matching native artifact, or set @VARIABLE_PREFIX@_LIBRARY explicitly.")
  endif()

  set(@VARIABLE_PREFIX@_GLUE_SOURCE "${@VARIABLE_PREFIX@_GLUE_ROOT}/TeaVMCGlue.cpp")
  if(NOT EXISTS "${@VARIABLE_PREFIX@_GLUE_SOURCE}")
    message(FATAL_ERROR "Missing @LIBRARY_NAME@ TeaVM C glue source: ${@VARIABLE_PREFIX@_GLUE_SOURCE}")
  endif()
  target_sources(${JPARSER_TEAVMC_APP_TARGET} PRIVATE "${@VARIABLE_PREFIX@_GLUE_SOURCE}")
  set_source_files_properties("${@VARIABLE_PREFIX@_GLUE_SOURCE}" PROPERTIES LANGUAGE CXX)
  target_link_libraries(${JPARSER_TEAVMC_APP_TARGET} PRIVATE "${@VARIABLE_PREFIX@_LIBRARY}")
  set(@VARIABLE_PREFIX@_ACTIVE_IMPORT_HEADER "${@VARIABLE_PREFIX@_IMPORT_HEADER}")
else()
  if(NOT DEFINED @VARIABLE_PREFIX@_SHARED_LIBRARY OR "${@VARIABLE_PREFIX@_SHARED_LIBRARY}" STREQUAL "")
    set(@VARIABLE_PREFIX@_SHARED_CANDIDATES)
    if(NOT "${@VARIABLE_PREFIX@_PLATFORM}" STREQUAL "")
      if(WIN32 AND NOT "${@VARIABLE_PREFIX@_MSVC_RUNTIME_SUBDIR}" STREQUAL "")
        list(APPEND @VARIABLE_PREFIX@_SHARED_CANDIDATES
          "${@VARIABLE_PREFIX@_NATIVE_ROOT}/${@VARIABLE_PREFIX@_PLATFORM}/${@VARIABLE_PREFIX@_MSVC_RUNTIME_SUBDIR}/shared/${@VARIABLE_PREFIX@_SHARED_FILE}"
          "${@VARIABLE_PREFIX@_NATIVE_ROOT}/${@VARIABLE_PREFIX@_PLATFORM}/${@VARIABLE_PREFIX@_MSVC_RUNTIME_SUBDIR}/${@VARIABLE_PREFIX@_SHARED_FILE}")
      endif()
      list(APPEND @VARIABLE_PREFIX@_SHARED_CANDIDATES
        "${@VARIABLE_PREFIX@_NATIVE_ROOT}/${@VARIABLE_PREFIX@_PLATFORM}/shared/${@VARIABLE_PREFIX@_SHARED_FILE}"
        "${@VARIABLE_PREFIX@_NATIVE_ROOT}/${@VARIABLE_PREFIX@_PLATFORM}/${@VARIABLE_PREFIX@_SHARED_FILE}")
    endif()
    foreach(@VARIABLE_PREFIX@_CANDIDATE IN LISTS @VARIABLE_PREFIX@_SHARED_CANDIDATES)
      if(EXISTS "${@VARIABLE_PREFIX@_CANDIDATE}")
        set(@VARIABLE_PREFIX@_SHARED_LIBRARY "${@VARIABLE_PREFIX@_CANDIDATE}")
        break()
      endif()
    endforeach()
  endif()
  if(NOT @VARIABLE_PREFIX@_SHARED_LIBRARY OR NOT EXISTS "${@VARIABLE_PREFIX@_SHARED_LIBRARY}")
    message(FATAL_ERROR "Missing @LIBRARY_NAME@ TeaVM C shared library. Add the matching native artifact, or set @VARIABLE_PREFIX@_SHARED_LIBRARY explicitly (required for future iOS-C layouts).")
  endif()

  if(@VARIABLE_PREFIX@_LINKAGE STREQUAL "SHARED_LINKED")
    if(WIN32)
      if(NOT DEFINED @VARIABLE_PREFIX@_IMPORT_LIBRARY OR "${@VARIABLE_PREFIX@_IMPORT_LIBRARY}" STREQUAL "")
        set(@VARIABLE_PREFIX@_IMPORT_CANDIDATES)
        if(NOT "${@VARIABLE_PREFIX@_MSVC_RUNTIME_SUBDIR}" STREQUAL "")
          list(APPEND @VARIABLE_PREFIX@_IMPORT_CANDIDATES
            "${@VARIABLE_PREFIX@_NATIVE_ROOT}/${@VARIABLE_PREFIX@_PLATFORM}/${@VARIABLE_PREFIX@_MSVC_RUNTIME_SUBDIR}/shared/${@VARIABLE_PREFIX@_IMPORT_FILE}"
            "${@VARIABLE_PREFIX@_NATIVE_ROOT}/${@VARIABLE_PREFIX@_PLATFORM}/${@VARIABLE_PREFIX@_MSVC_RUNTIME_SUBDIR}/${@VARIABLE_PREFIX@_IMPORT_FILE}")
        endif()
        list(APPEND @VARIABLE_PREFIX@_IMPORT_CANDIDATES
          "${@VARIABLE_PREFIX@_NATIVE_ROOT}/${@VARIABLE_PREFIX@_PLATFORM}/shared/${@VARIABLE_PREFIX@_IMPORT_FILE}"
          "${@VARIABLE_PREFIX@_NATIVE_ROOT}/${@VARIABLE_PREFIX@_PLATFORM}/${@VARIABLE_PREFIX@_IMPORT_FILE}")
        foreach(@VARIABLE_PREFIX@_CANDIDATE IN LISTS @VARIABLE_PREFIX@_IMPORT_CANDIDATES)
          if(EXISTS "${@VARIABLE_PREFIX@_CANDIDATE}")
            set(@VARIABLE_PREFIX@_IMPORT_LIBRARY "${@VARIABLE_PREFIX@_CANDIDATE}")
            break()
          endif()
        endforeach()
      endif()
      if(NOT @VARIABLE_PREFIX@_IMPORT_LIBRARY OR NOT EXISTS "${@VARIABLE_PREFIX@_IMPORT_LIBRARY}")
        message(FATAL_ERROR "Missing @LIBRARY_NAME@ TeaVM C Windows import library. Set @VARIABLE_PREFIX@_IMPORT_LIBRARY explicitly.")
      endif()
      target_link_libraries(${JPARSER_TEAVMC_APP_TARGET} PRIVATE "${@VARIABLE_PREFIX@_IMPORT_LIBRARY}")
    else()
      target_link_libraries(${JPARSER_TEAVMC_APP_TARGET} PRIVATE "${@VARIABLE_PREFIX@_SHARED_LIBRARY}")
    endif()
    set(@VARIABLE_PREFIX@_ACTIVE_IMPORT_HEADER "${@VARIABLE_PREFIX@_IMPORT_HEADER}")
  else()
    # Runtime-loaded mode deliberately has no link dependency on the plugin.
    if(CMAKE_DL_LIBS)
      target_link_libraries(${JPARSER_TEAVMC_APP_TARGET} PRIVATE ${CMAKE_DL_LIBS})
    endif()
    set(@VARIABLE_PREFIX@_ACTIVE_IMPORT_HEADER "${@VARIABLE_PREFIX@_DISPATCH_HEADER}")
  endif()

  # Both dynamic modes stage beside the executable by default. Keep that
  # directory in the loader search path for direct linkage and dlopen alike.
  if(APPLE)
    set_property(TARGET ${JPARSER_TEAVMC_APP_TARGET} APPEND PROPERTY BUILD_RPATH "@loader_path")
    set_property(TARGET ${JPARSER_TEAVMC_APP_TARGET} APPEND PROPERTY INSTALL_RPATH "@loader_path")
  elseif(UNIX AND NOT ANDROID)
    set_property(TARGET ${JPARSER_TEAVMC_APP_TARGET} APPEND PROPERTY BUILD_RPATH "$ORIGIN")
    set_property(TARGET ${JPARSER_TEAVMC_APP_TARGET} APPEND PROPERTY INSTALL_RPATH "$ORIGIN")
  endif()

  if(NOT DEFINED @VARIABLE_PREFIX@_RUNTIME_OUTPUT_DIRECTORY OR "${@VARIABLE_PREFIX@_RUNTIME_OUTPUT_DIRECTORY}" STREQUAL "")
    if(DEFINED JPARSER_TEAVMC_RUNTIME_OUTPUT_DIRECTORY AND NOT "${JPARSER_TEAVMC_RUNTIME_OUTPUT_DIRECTORY}" STREQUAL "")
      set(@VARIABLE_PREFIX@_RUNTIME_OUTPUT_DIRECTORY "${JPARSER_TEAVMC_RUNTIME_OUTPUT_DIRECTORY}")
    else()
      set(@VARIABLE_PREFIX@_RUNTIME_OUTPUT_DIRECTORY "$<TARGET_FILE_DIR:${JPARSER_TEAVMC_APP_TARGET}>")
    endif()
  endif()
  add_custom_command(TARGET ${JPARSER_TEAVMC_APP_TARGET} POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E make_directory "${@VARIABLE_PREFIX@_RUNTIME_OUTPUT_DIRECTORY}"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different
      "${@VARIABLE_PREFIX@_SHARED_LIBRARY}"
      "${@VARIABLE_PREFIX@_RUNTIME_OUTPUT_DIRECTORY}"
    VERBATIM)
endif()

@CONSUMER_CONFIG@

if(NOT EXISTS "${@VARIABLE_PREFIX@_ACTIVE_IMPORT_HEADER}")
  message(FATAL_ERROR "Missing @LIBRARY_NAME@ TeaVM C import/dispatch header: ${@VARIABLE_PREFIX@_ACTIVE_IMPORT_HEADER}")
endif()

file(GLOB_RECURSE @VARIABLE_PREFIX@_GENERATED_C_SOURCES CONFIGURE_DEPENDS
  "${JPARSER_TEAVMC_GENERATED_SOURCE_ROOT}/*.c")
if(MSVC)
  foreach(@VARIABLE_PREFIX@_SOURCE IN LISTS @VARIABLE_PREFIX@_GENERATED_C_SOURCES)
    set_property(SOURCE "${@VARIABLE_PREFIX@_SOURCE}" APPEND PROPERTY
      COMPILE_OPTIONS "/FI${@VARIABLE_PREFIX@_ACTIVE_IMPORT_HEADER}")
  endforeach()
else()
  foreach(@VARIABLE_PREFIX@_SOURCE IN LISTS @VARIABLE_PREFIX@_GENERATED_C_SOURCES)
    set_property(SOURCE "${@VARIABLE_PREFIX@_SOURCE}" APPEND PROPERTY
      COMPILE_OPTIONS "-include" "${@VARIABLE_PREFIX@_ACTIVE_IMPORT_HEADER}")
  endforeach()
endif()
